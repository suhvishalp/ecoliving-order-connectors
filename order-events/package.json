{
  "name": "order-events",
  "version": "1.0.0",
  "description": "LHC order events \u2014 the payment-success handler, pushed by a Connect-provisioned queue (course Session 8.3)",
  "main": "dist/index.js",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node scripts/test.mjs",
