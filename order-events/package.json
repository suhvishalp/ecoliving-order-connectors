  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "source-map-js": "^1.2.2",
    "body-parser": "^1.20.9"
  }
}
