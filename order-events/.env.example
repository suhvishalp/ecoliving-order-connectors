# Local development only. At deploy time these become standardConfiguration / securedConfiguration,
# entered once in the install form and — for the secured ones — never displayed again (Session 9.1).
CTP_PROJECT_KEY=
CTP_REGION=europe-west1.gcp
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=
CTP_SCOPE=

# This app talks to the commercetools API directly — it does NOT call the BFF, because once deployed
# it runs in Connect's cloud where your laptop is unreachable. It moves the order through Session 6's
# guarded state machine, which the platform enforces either way.
TARGET_STATE_KEY=order-picked
