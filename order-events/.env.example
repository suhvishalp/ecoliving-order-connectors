# Local development only. Deployed, the CTP_* values are injected by Connect from the API Client it
# generates from inheritAs.apiClient.scopes — nobody enters them.
CTP_PROJECT_KEY=
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=
CTP_API_URL=https://api.europe-west1.gcp.commercetools.com
CTP_AUTH_URL=https://auth.europe-west1.gcp.commercetools.com
CTP_SCOPE=

# This app moves the order through the commercetools API DIRECTLY — it does not call the BFF, because
# once deployed it runs in Connect's cloud where your laptop is unreachable.
TARGET_STATE_KEY=order-picked
CONFIRM_ORDER_STATE=true
# Backlog guard: unacknowledged messages live 7 days, so a handler broken over a weekend comes back to
# a stampede. Refuse to act on anything older than this.
MAX_MESSAGE_AGE_HOURS=72

LOG_LEVEL=info
