# Local development only. Deployed, the CTP_* values are injected by Connect from the API Client it
# generates from inheritAs.apiClient.scopes.
CTP_PROJECT_KEY=
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=
CTP_API_URL=https://api.europe-west1.gcp.commercetools.com
CTP_AUTH_URL=https://auth.europe-west1.gcp.commercetools.com
CTP_SCOPE=
# The Import API is a separate host; derived from CTP_API_URL unless set.
CTP_IMPORT_URL=

IMPORT_CONTAINER_KEY=lhc-price-feed
# Where the feed is read from. In production this would be SFTP/S3/an ERP endpoint — see FeedSource,
# which exists so swapping it is one file.
FEED_CONTAINER=lhc-price-feed
FEED_KEY=pending

# A job has no concurrency guard from the platform; this one locks. A lock older than this is assumed
# abandoned and taken over.
LOCK_STALE_MINUTES=45
POLL_TIMEOUT_SECONDS=120
POLL_INTERVAL_SECONDS=5

LOG_LEVEL=info
